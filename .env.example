# ============================================================
# CinemaScope — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ----- Supabase Configuration -----
# Your Supabase project URL (from https://supabase.com/dashboard/project/_/settings/api)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon (public) key — safe for client use with proper RLS policies
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ----- TMDB API Configuration -----
# Get your free API key at https://www.themoviedb.org/settings/api (free, no credit card)
VITE_TMDB_API_KEY=your-tmdb-api-key-here

# ----- X (Twitter) API Configuration (Optional) -----
# Required only for live X/Twitter poster discovery feature.
# Server-side use only — do NOT prefix with VITE_ if using a backend proxy.
# Leave blank to use the offline mock data fallback.
# X_API_BEARER_TOKEN=your-x-api-bearer-token-here

# ----- Application Configuration -----
# Admin email address (the account that gets ADMIN role automatically on login)
VITE_ADMIN_EMAIL=your-admin-email@example.com

# App base URL (used for OAuth redirects)
VITE_APP_URL=http://localhost:5173

# ----- Build Configuration -----
# NODE_ENV is set automatically by Vite (development | production)
# No need to set it manually here.
